<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fungusware.WinFormsThemes</RootNamespace>
    <Authors>Fungusware</Authors>
    <Company>Fungusware</Company>
    <Copyright>Copyright (c) 2026 Fungusware</Copyright>
    <Description>Fungusware.WinFormsThemes for ObjectListView: themed headers, selection colours, empty-list message and column sizing that follow the active theme.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>Fungusware.WinFormsThemes.ObjectListView</PackageId>
    <Version>2026.11.24.1000</Version>
    <PackageTags>winforms;theme;objectlistview;dark-mode</PackageTags>
    <RepositoryUrl>https://github.com/Fungusware/Fungusware.WinFormsThemes</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Fungusware/Fungusware.WinFormsThemes</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ObjectListView.Repack.NET6Plus" Version="2.9.5" />
    <ProjectReference Include="..\Fungusware.WinFormsThemes\Fungusware.WinFormsThemes.csproj" />
  </ItemGroup>
</Project>
