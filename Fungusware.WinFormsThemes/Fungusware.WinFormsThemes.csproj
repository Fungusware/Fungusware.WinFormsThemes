<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fungusware.WinFormsThemes</RootNamespace>
    <Authors>Fungusware</Authors>
    <Company>Fungusware</Company>
    <Copyright>Copyright (c) 2026 Fungusware</Copyright>
    <Description>Themes for WinForms apps: colour tokens, ready-made light and dark themes, in-place styling of plain WinForms controls, a flat menu and toolbar renderer, status colours, and adapters that carry the theme to Krypton, ObjectListView and other control suites. No third-party dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>Fungusware.WinFormsThemes</PackageId>
    <Version>2026.11.24.1000</Version>
    <PackageTags>winforms;theme;dark-mode;flat;fluent</PackageTags>
    <RepositoryUrl>https://github.com/Fungusware/Fungusware.WinFormsThemes</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Fungusware/Fungusware.WinFormsThemes</PackageProjectUrl>
  </PropertyGroup>
</Project>
